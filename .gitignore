# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# .env is committed on purpose and not ignored: it holds only public values (the Supabase URL,
# the publishable key and the USDA key), and EAS cloud builds upload only files git doesn't ignore.
# Never put a secret in it (no sb_secret_ / service_role key, no Claude key).

# Supabase CLI
supabase/.temp/
supabase/.branches/
supabase/functions/.env
