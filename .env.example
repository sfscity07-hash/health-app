# Copy this file to .env and fill in your own values (no quotes, no spaces around =).
# Find them in Supabase → Project Settings → Data API (URL) and → API Keys (key).
#
#   URL looks like:  https://abcdefghijklmnopqrst.supabase.co   (no trailing /)
#   Key looks like:  sb_publishable_…   (newer projects)
#               or:  eyJhbGciOi…        (older "anon" key, a long token with two dots)
#
# The publishable (anon) key is safe to ship in the app: row-level security
# keeps every user's data private. Never put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
